### Copy this file to `.env` and fill in your API keys. Do NOT commit `.env`.

# Hugging Face Hub token (optional, speeds downloads)
HF_TOKEN=

# Qwen or other provider API key (example placeholder)
QWEN_API_KEY=

# Model selection (must be <=10B parameters). Example: meta-llama/Llama-2-7b-chat-hf
LLM_MODEL_NAME=meta-llama/Llama-2-7b-chat-hf

# Optional LLM settings
LLM_MAX_NEW_TOKENS=256
LLM_TEMPERATURE=0.2
